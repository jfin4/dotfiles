snippet top
	# ${1:title}
	# john.inman@waterboards.ca.gov
	# `strftime('%F')`

	# LOAD ========================================================================={{{

	# packages{{{
	library(data.table)
	library(fs)
	library(readxl)
	library(tools)
	library(writexl)
	library(tidyverse)# }}}

	# files{{{
	rm(list = ls(all = TRUE))

	read <- function(path, sheet = NULL) {
		ext <- file_ext(path)
		if (ext == "xlsx") {
			read_excel(path, sheet = sheet, col_types = "text", na = "", progress = FALSE)
		} else {
			fread(path, colClasses = "character", na.strings = "", showProgress = FALSE) |>
				as_tibble()
		}
	}

	$2

	.data_loaded <- NULL
	rm(list = ls())
	save.image("./.RData")
	# }}}

	rm(list = ls())

	if (!exists(".data_loaded")) {
		load(".RData")
	}# }}}

	# END

snippet lookups
	path <- "${1:path}"
	sheets <- excel_sheets(path)
	.lookups <- 
		map(sheets, \\(x) read_excel(path, x, col_types = "text")) |>
		set_names(sheets)

snippet x
	\\(${1:x})

snippet many
	relationship = "many-to-many"

snippet read_excel
	read_excel(${1:path}, 
	           sheet = ${2:1},
	           col_types = "text",
			   na = "")

snippet fread
	fread(${1:path}, 
	      colClasses = "character",
	      na.strings = "")

snippet sec
	# $1==============================================================================

snippet sub
	# $1------------------------------------------------------------------------------

snippet origin
	mutate(SampleDate = as.Date(as.numeric(SampleDate), origin = "1899-12-30"))

snippet in
	%in%

snippet nin
	%nin%

snippet ~
	%~%


snippet meta
	# ${1:title}
	# john.inman@waterboards.ca.gov
	# `strftime('%F')`

snippet library
	# load packages
	# ------------------------------------------------------------------------------

	library(data.table)
	library(fs)
	library(readxl)
	library(writexl)
	library(tidyverse)

snippet data
	# load data
	# ------------------------------------------------------------------------------

	# read files{{{
	rm(list = ls(all = TRUE))

	$0

	.data_loaded <- NULL
	save.image(".RData")
	#}}}

	if (!exists(".data_loaded")) {
		load(".RData")
	}

	rm(list = ls())

snippet new
	meta$0

	library

	data

	# END

snippet lookups
	path <- "${1:path}"
	sheets <- excel_sheets(path)
	.lookups <- 
		map(sheets, \\(x) read_excel(path, x, col_types = "text")) |>
		set_names(sheets)

snippet x
	\\(${1:x})

snippet relationship
	relationship = "many-to-many"

snippet read_excel
	read_excel(${1:path}, 
	           sheet = ${2:sheet},
	           col_types = "text")

snippet read_csv
	read_csv(${1:path}, 
	         col_types = cols(.default = "c"))

snippet read_tsv
	read_tsv(${1:path}, 
	         col_types = cols(.default = "c"))

snippet fread
	fread(${1:path}, 
	      colClasses = "character")

snippet read.csv
	read.csv(${1:path}, 
	         colClasses = "character")

snippet read.delim
	read.delim(${1:path}, 
	           colClasses = "character")

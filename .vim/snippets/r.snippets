snippet ()
	\\(${1:x})

snippet mm
	relationship = "many-to-many"

snippet origin
	origin = "1899-12-30")

snippet in
	%in%

snippet nin
	%nin%

snippet ~
	%~%


snippet input
	input <- c(
		${1:name} = "${2:path}"
	)
	get_input(input)
	rm(list = setdiff(ls(), names(input)))

snippet library
	suppressPackageStartupMessages({
		library(dplyr)
		library(stringr)
		library(rlang)
		library(writexl)
		library(fs)
	})

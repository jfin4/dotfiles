snippet todo
	#todo $0

snippet question
	#question $0

snippet note
	`strftime('%Y-%m-%d')` 
	`repeat('-', 78)`

	$0


snippet link
	#link $0

snippet task
	`getline(line(".") - 1)[0:5]`\
	${1:`getline(line(".") - 1)[6:7]`}, \
	${2:`getline(line(".") - 1)[16:19]`}, \
	${3:hhmm}, \
	${4:w}, \
	${5:<description>}
	task$0


#!/usr/bin/env zsh

conf=~/.wg/us-sjc-wg-401.conf

wg-quick up $conf &> /dev/null &

until sudo wg show interfaces | grep -q "."; do
    echo "connecting to vpn..."
    sleep 1
done

xsetroot -name "$(status)"

qbittorrent-nox &> /dev/null &
PID=$!

until curl -s localhost:8080 | grep -q "qBittorrent"; do
    echo "starting qbittorrent..."
    sleep 1
done

firefox localhost:8080 &> /dev/null &
firefox yts.gg/home &> /dev/null &

echo "ready..."

trap '
    kill $PID
    wg-quick down $conf &> /dev/null
    xsetroot -name "$(status)"
    trap - INT
' INT

echo '
